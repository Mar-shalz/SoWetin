{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start --port 3300",
      "url": ["http://localhost:3300/"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 153600 }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 30720 }],
        "resource-summary:font:size": ["error", { "maxNumericValue": 66560 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 358400 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
