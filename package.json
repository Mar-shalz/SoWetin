{
  "name": "sowetin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval:ai": "vitest run --config vitest.eval.config.ts",
    "tokens": "node scripts/tokens-css.mjs",
    "fonts": "bash scripts/subset-fonts.sh",
    "i18n:check": "node scripts/i18n-check.ts",
    "seed:validate": "node scripts/validate-seed.ts",
    "seed:import": "node scripts/import-seed.ts",
    "db:reset": "supabase db reset",
    "gen:types": "supabase gen types typescript --local > lib/db/types.ts",
    "lhci": "pnpm dlx @lhci/cli@0.16.0 autorun",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.18"
  },
  "type": "module"
}
